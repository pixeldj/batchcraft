{
  "browser": {
    "browserName": "chromium",
    "isolated": true,
    "launchOptions": { "channel": "chromium", "headless": true },
    "contextOptions": { "viewport": { "width": 1440, "height": 1000 }, "serviceWorkers": "block" }
  },
  "network": {
    "allowedOrigins": ["http://127.0.0.1:5174", "http://127.0.0.1:8001", "http://127.0.0.1:5175", "http://127.0.0.1:8002"]
  },
  "outputDir": "../.local/browser",
  "imageResponses": "allow"
}

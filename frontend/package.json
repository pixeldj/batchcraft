{
  "name": "batchcraft-frontend",
  "private": true,
  "version": "1.1.0",
  "license": "GPL-3.0-only",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check:distribution": "node --test scripts/check-distribution.mjs",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "browser:install": "playwright install chromium && node node_modules/playwright/cli.js install chromium",
    "browser:mcp": "playwright-mcp --config playwright-mcp.json",
    "browser:check": "node scripts/check-browser.mjs"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/mcp": "0.0.80",
    "@playwright/test": "1.62.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.68.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
